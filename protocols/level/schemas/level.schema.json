{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-engine.dev/formats/level/1/level.schema.json",
  "title": "Aether level (format version 1)",
  "description": "A level file (.alevel). See docs/formats/level-v1.md. Component data is validated by the engine per component type; this schema fixes the document structure and the built-in components.",
  "type": "object",
  "required": ["format", "version", "entities"],
  "properties": {
    "format": { "const": "aether.level" },
    "version": { "const": 1 },
    "generator": { "type": "string", "description": "Tool that wrote the file (informational)." },
    "entities": {
      "type": "array",
      "description": "Parents appear before their children; siblings appear in child order.",
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "entity": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "parent": { "$ref": "#/$defs/uuid" },
        "components": {
          "type": "object",
          "description": "Keyed by component name. Unknown names are allowed and preserved by the engine.",
          "properties": {
            "Name": {
              "type": "object",
              "properties": { "value": { "type": "string" } },
              "additionalProperties": false
            },
            "Transform": {
              "type": "object",
              "properties": {
                "position": { "$ref": "#/$defs/vec3" },
                "rotation": { "$ref": "#/$defs/quat", "description": "Quaternion (x, y, z, w)." },
                "scale": { "$ref": "#/$defs/vec3" }
              },
              "additionalProperties": false
            },
            "MeshInstance": {
              "type": "object",
              "properties": {
                "mesh": { "type": "string", "description": "Mesh name: builtin:cube or asset:<content path>#mesh<m>.<p>." },
                "color": { "$ref": "#/$defs/vec3", "description": "Linear RGB, multiplied with the texture." },
                "texture": { "type": "string", "description": "Base colour texture: builtin:white (default when absent) or asset:<content path>#texture<t>." },
                "metallic": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 = dielectric (default), 1 = metal." },
                "roughness": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 = mirror, 1 = matte. Default 0.5." },
                "emissive": { "$ref": "#/$defs/vec3", "description": "Emitted linear RGB, added after lighting. Default [0, 0, 0]." },
                "normal_texture": { "type": "string", "description": "Tangent-space normal map, e.g. asset:<path>#texture<t>.linear. Absent: none." },
                "metallic_roughness_texture": { "type": "string", "description": "G = roughness, B = metallic multipliers (glTF layout), linear." }
              },
              "additionalProperties": false
            },
            "Environment": {
              "type": "object",
              "description": "Sky and image-wide settings; the first entity with one is used.",
              "properties": {
                "sky": { "$ref": "#/$defs/vec3", "description": "Zenith colour, linear RGB." },
                "horizon": { "$ref": "#/$defs/vec3" },
                "ground": { "$ref": "#/$defs/vec3", "description": "Colour below the horizon." },
                "intensity": { "type": "number", "minimum": 0, "description": "Brightness of the sky as a light and as a background." },
                "exposure": { "type": "number", "exclusiveMinimum": 0 },
                "shadows": { "type": "boolean", "description": "Sun shadows on/off." },
                "sky_visible": { "type": "boolean", "description": "Draw the sky behind the scene." }
              },
              "additionalProperties": false
            },
            "Light": {
              "type": "object",
              "properties": {
                "type": { "enum": ["directional", "point"], "description": "Directional: travels along the entity's -Z. Point: from its position." },
                "color": { "$ref": "#/$defs/vec3", "description": "Linear RGB." },
                "intensity": { "type": "number", "minimum": 0, "description": "Directional: about 3 for daylight. Point: intensity at 1 m." },
                "range": { "type": "number", "exclusiveMinimum": 0, "description": "Point lights: metres to fade out over." },
                "shadows": { "type": "boolean", "description": "Directional lights: cast shadows (the first such light does)." }
              },
              "additionalProperties": false
            },
            "Spin": {
              "type": "object",
              "properties": {
                "axis": { "$ref": "#/$defs/vec3" },
                "speed": { "type": "number", "description": "Radians per second." }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": { "type": ["object", "array", "string", "number", "boolean", "null"] }
        }
      },
      "additionalProperties": false
    }
  }
}
